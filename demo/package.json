		"@codingame/monaco-vscode-explorer-service-override": "36.2.7",
		"@codingame/monaco-vscode-extensions-service-override": "36.2.7",
		"@codingame/monaco-vscode-files-service-override": "36.2.7",
		"@codingame/monaco-vscode-keybindings-service-override": "36.2.7",
		"@codingame/monaco-vscode-languages-service-override": "36.2.7",
		"@codingame/monaco-vscode-lifecycle-service-override": "36.2.7",
		"@codingame/monaco-vscode-log-service-override": "36.2.7",
		"@codingame/monaco-vscode-markers-service-override": "36.2.7",
		"@codingame/monaco-vscode-model-service-override": "36.2.7",
		"@codingame/monaco-vscode-notifications-service-override": "36.2.7",
		"@codingame/monaco-vscode-quickaccess-service-override": "36.2.7",
		"@codingame/monaco-vscode-storage-service-override": "36.2.7",
		"@codingame/monaco-vscode-terminal-service-override": "36.2.7",
		"@codingame/monaco-vscode-textmate-service-override": "36.2.7",
		"@codingame/monaco-vscode-theme-defaults-default-extension": "36.2.7",
		"@codingame/monaco-vscode-theme-service-override": "36.2.7",
		"@codingame/monaco-vscode-workbench-service-override": "36.2.7",
		"monaco-editor": "npm:@codingame/monaco-vscode-editor-api@36.2.7",
		"typescript": "^5.6.0",
		"vite": "8.1.3",
		"vscode": "npm:@codingame/monaco-vscode-extension-api@36.2.7"
