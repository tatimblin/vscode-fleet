{
	"name": "@tristimb/fleet-demo",
	"version": "0.1.0",
	"description": "Real VS Code (monaco-vscode-api) running a mocked EV fleet extension, prebuilt as a static page, plus the <fleet-demo> click-to-launch element that embeds it.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tatimblin/vscode-fleet.git",
		"directory": "demo"
	},
	"exports": {
		".": "./src/element.ts",
		"./element.css": "./src/element.css",
		"./package.json": "./package.json"
	},
	"files": ["dist", "src/element.ts", "src/element.css"],
	"scripts": {
		"dev": "vite",
		"build": "bunx --bun vite build",
		"preview": "vite preview",
		"check-types": "tsc --noEmit",
		"test": "bun test ./test"
	},
	"devDependencies": {
		"@codingame/monaco-vscode-api": "36.2.7",
		"@codingame/monaco-vscode-configuration-service-override": "36.2.7",
